// Prisma schema for the Phoneme Activity Builder backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum GenerationStatus {
  SUCCESS
  FAILURE
}

enum GenerationSource {
  BUILDER
  SAVED
}

model Activity {
  id         String       @id @default(cuid())
  name       String
  type       ActivityType
  difficulty Difficulty   @default(MEDIUM)
  showHints  Boolean      @default(true)

  numGuesses Int?

  rows       Int?
  cols       Int?

  words      Word[]
  generations GenerationEvent[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("activities")
}

model Word {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // Ordered phoneme units. Each unit may be more than one character
  // (e.g. IPA digraphs like "tʃ"), so this is stored as a text array
  // rather than splitting into single characters.
  phonemes   String[]
  english    String?

  // Display/solve order of the word within the activity's word list.
  position   Int      @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([activityId])
  @@map("words")
}

model GenerationEvent {
  id           String           @id @default(cuid())

  // Optional link to a saved activity when generating from stored data.
  activityId   String?
  activity     Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)

  activityType ActivityType
  status       GenerationStatus
  source       GenerationSource @default(BUILDER)
  wordCount    Int              @default(0)
  durationMs   Int              @default(0)
  errorMessage String?

  createdAt    DateTime         @default(now())

  @@index([createdAt])
  @@index([activityType])
  @@index([status])
  @@index([activityId])
  @@map("generation_events")
}

model PageView {
  id         String   @id @default(cuid())
  path       String
  sessionId  String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}
