# Copy this file to .env and adjust values before running `docker compose up`.
# Never commit the real .env file - only .env.example is tracked in git.

# --- Database ---
POSTGRES_USER=phoneme_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=phoneme_builder
POSTGRES_PORT=5432

# --- Backend API ---
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
# Must be reachable from the browser, so use the published backend port,
# not the internal "backend" service hostname.
NEXT_PUBLIC_API_URL=http://localhost:4000
